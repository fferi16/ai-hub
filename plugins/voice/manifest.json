{
  "name": "voice",
  "version": "0.2.0",
  "description": "Magyar beszéd helyben: diktálás Ctrl+Alt+D-vel, hangasszisztens „Figyelj”-re (gyors ébresztőszó-modell), mikrofon → szöveg",
  "tools": [
    {
      "name": "voice_listen",
      "level": "act"
    },
    {
