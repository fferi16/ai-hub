      "level": "read"
    },
    {
      "name": "voice_dictation",
      "level": "act"
    },
    {
      "name": "voice_assistant",
      "level": "act"
    },
    {
      "name": "voice_enroll",
      "level": "act"
    }
  ],
  "deps": [
    "faster-whisper",
    "sounddevice",
    "imageio-ffmpeg",
    "pywin32",
    "numpy",
    "openwakeword==0.6.0",
    "scikit-learn",
    "scipy"
  ]
}
